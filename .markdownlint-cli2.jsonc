{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    // README.md is generated (see src/build-readme.ts) as a single long
    // intro paragraph with no top-level heading; MD013/MD041 don't fit
    // that layout. Everything else (CODE_OF_CONDUCT.md, SECURITY.md, and
    // any future .md file) is held to the full default rule set.
    "MD013": false,
    "MD041": false
  },
  "globs": ["**/*.md"],
  "ignores": ["README.template.md", "node_modules"]
}
